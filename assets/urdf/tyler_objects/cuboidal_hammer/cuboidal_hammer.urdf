<?xml version="1.0"?>
<robot name="hammer">

  <link name="hammer">
    <!-- Handle -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.05 0.025"/>
      </geometry>
      <material name="brown">
        <color rgba="0.55 0.27 0.07 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.05 0.025"/>
      </geometry>
    </collision>

    <!-- Head -->
    <visual>
      <origin xyz="0.0625 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.1 0.025"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0625 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.1 0.025"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

</robot>
