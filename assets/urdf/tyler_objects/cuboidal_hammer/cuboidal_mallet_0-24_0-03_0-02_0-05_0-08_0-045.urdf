<?xml version="1.0"?>
<robot name="cuboidal_hammer">

  <link name="hammer">
    <!-- Handle -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.03 0.02"/>
      </geometry>
      <material name="brown">
        <color rgba="0.55 0.27 0.07 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.03 0.02"/>
      </geometry>
    </collision>

    <!-- Head -->
    <visual>
      <origin xyz="0.145 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.045"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.145 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.045"/>
      </geometry>
    </collision>

    <inertial>
      <density value="400"/>
    </inertial>
  </link>

</robot>
