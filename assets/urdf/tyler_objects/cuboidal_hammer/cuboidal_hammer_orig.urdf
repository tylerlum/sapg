<?xml version="1.0"?>
<robot name="hammer">

  <!-- Handle -->
  <link name="handle">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- length (x): 0.10 m, width (y): 0.05 m, thickness (z): 0.025 m -->
        <box size="0.10 0.05 0.025"/>
      </geometry>
      <material name="brown">
        <color rgba="0.55 0.27 0.07 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.05 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Hammer Head -->
  <link name="head">
    <visual>
      <!-- 5 cm long along Y, cross section 5x2.5 cm -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.1 0.025"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.1 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Joint connecting handle and head -->
  <joint name="handle_to_head" type="fixed">
    <!-- The head attaches at the top of the handle -->
    <!-- Handle length is 10 cm, so we move 5 cm (0.05 m) along +X -->
    <!-- Head is 5 cm long, centered, so we offset it along Y -->
    <parent link="handle"/>
    <child link="head"/>
    <origin xyz="0.0625 0 0" rpy="0 0 0"/>
  </joint>

</robot>

