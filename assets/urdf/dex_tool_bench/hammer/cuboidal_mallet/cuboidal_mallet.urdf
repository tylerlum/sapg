<?xml version="1.0"?>
<robot name="cuboidal_mallet">

  <link name="cuboidal_mallet">
    <!-- Handle -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.03 0.02"/>
      </geometry>
      <material name="material">
        <color rgba="0.639 0.847 0.882 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.03 0.02"/>
      </geometry>
    </collision>

    <!-- Head -->
    <visual>
      <origin xyz="0.145 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.045"/>
      </geometry>
      <material name="material">
        <color rgba="0.639 0.847 0.882 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.145 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.045"/>
      </geometry>
    </collision>

    <inertial>
      <density value="400.0"/>
    </inertial>
  </link>

</robot>
