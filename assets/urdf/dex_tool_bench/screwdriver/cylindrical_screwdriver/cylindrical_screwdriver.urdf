<?xml version="1.0"?>
<robot name="cylindrical_screwdriver">

  <link name="cylindrical_screwdriver">
    <!-- Handle -->
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry>
        <cylinder length="0.18" radius="0.015"/>
      </geometry>
      <material name="material">
        <color rgba="0.639 0.847 0.882 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry>
        <cylinder length="0.18" radius="0.015"/>
      </geometry>
    </collision>

    <!-- Head -->
    <visual>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.006 0.006"/>
      </geometry>
      <material name="material">
        <color rgba="0.639 0.847 0.882 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.006 0.006"/>
      </geometry>
    </collision>

    <inertial>
      <density value="400.0"/>
    </inertial>
  </link>

</robot>
